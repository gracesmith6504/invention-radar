FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

ARG OPENSHELL_VERSION=0.0.80

RUN microdnf install -y tar gzip sed bash openssh-clients && microdnf clean all

RUN ARCH=$(uname -m) && \
    curl -LsSf "https://github.com/NVIDIA/OpenShell/releases/download/v${OPENSHELL_VERSION}/openshell-${ARCH}-unknown-linux-musl.tar.gz" \
      -o /tmp/openshell.tar.gz && \
    tar -xzf /tmp/openshell.tar.gz -C /usr/local/bin/ && \
    rm /tmp/openshell.tar.gz && \
    chmod +x /usr/local/bin/openshell

COPY launcher.sh /app/launcher.sh
RUN chmod +x /app/launcher.sh

RUN useradd -r -m -s /bin/bash launcher
USER launcher

ENTRYPOINT ["/bin/bash"]
